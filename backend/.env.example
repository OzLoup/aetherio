# Copy to .env for local development. In production these come from the
# platform's secret store (see DEPLOY.md), never from a committed file.

# "production" enables startup safety checks (refuses weak/missing secrets).
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://aetherio:aetherio@localhost:5433/aetherio

JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Encrypts addon URLs at rest (they can carry API keys). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes the stored addon URLs unreadable.
DATA_ENCRYPTION_KEY=

# Google login — create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials with this redirect URI.
# Empty = the "Continuar con Google" button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

FRONTEND_URL=http://localhost:5173
# JSON list. The macOS app serves its UI from app://ui.
EXTRA_CORS_ORIGINS=["app://ui"]
# Google OAuth cookie: true in production (HTTPS).
SESSION_HTTPS_ONLY=false

# Addons hosted on localhost / LAN. Keep false on any public deploy (SSRF).
ADDON_ALLOW_PRIVATE_HOSTS=true
