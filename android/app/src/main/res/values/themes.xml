<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorPrimary">#12518B</item>
        <item name="android:colorAccent">#12518B</item>
        <item name="android:statusBarColor">#0B0918</item>
        <item name="android:navigationBarColor">#0B0918</item>
    </style>
    <style name="PlayerTheme" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
    <!-- Player buttons (top bar and panels). -->
    <style name="PlayerTopButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/top_button</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
